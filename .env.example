# OpenAI API Key (required - all three engines call OpenAI to write the answer,
# and LightRAG also uses it for indexing)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings run locally via sentence-transformers, so no embedding API key is needed.

# Neo4j Database Configuration (required for GraphRAG only)
# These override the matching values in config.yaml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Used by docker compose to set the Neo4j container's credentials.
# Keep it in sync with NEO4J_PASSWORD above.
NEO4J_AUTH=neo4j/password
